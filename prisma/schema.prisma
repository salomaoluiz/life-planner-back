model InvestmentOperation {
  id                       String                               @id @default(uuid())
  asset_id                 String
  type                     InvestmentOperationType
  date                     DateTime                             @db.Date
  quantity                 Decimal?                             @db.Decimal(18, 8)
  unit_price               Decimal?                             @db.Decimal(20, 8)
  gross                    Int?
  fees_total               Int?
  total                    Int?
  ratio_from               Decimal?                             @db.Decimal(18, 8)
  ratio_to                 Decimal?                             @db.Decimal(18, 8)
  bonus_percent            Decimal?                             @db.Decimal(12, 8)
  bonus_unit_cost          Decimal?                             @db.Decimal(20, 8)
  fraction_of_operation_id String?                              @unique
  event_suggestion_id      String?                              @unique
  generate_transaction     Boolean
  account_id               String?
  transaction_id           String?                              @unique
  fx_rate                  Decimal?                             @db.Decimal(12, 6)
  redemption_kind          InvestmentFixedIncomeRedemptionKind?
  net_amount               Int?
  conversion_id            String?
  conversion_cost          Int?
  fraction_quantity        Decimal?                             @db.Decimal(18, 8)
  fraction_cost            Int?
  cash_cost                Int?
