  updated_at               DateTime                             @updatedAt @db.Timestamptz(6)

  conversion       InvestmentConversion?      @relation(fields: [conversion_id], references: [id], onDelete: Cascade)
  asset            InvestmentAsset            @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  account          FinancialAccount?          @relation(fields: [account_id], references: [id], onDelete: SetNull)
  transaction      FinancialTransaction?      @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  fees             InvestmentOperationFee[]
  fraction_of      InvestmentOperation?       @relation("FractionSale", fields: [fraction_of_operation_id], references: [id], onDelete: SetNull)
  fraction_sale    InvestmentOperation?       @relation("FractionSale")
  event_suggestion InvestmentEventSuggestion? @relation(fields: [event_suggestion_id], references: [id], onDelete: SetNull)

  @@unique([conversion_id, type])
  @@index([asset_id, date, created_at, id])
  @@index([account_id])
  @@map("investment_operations")
}

model InvestmentConversion {
