// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  password_hash  String
  photo_url      String?
  created_at     DateTime?      @default(now())
  updated_at     DateTime?      @updatedAt
  families       Family[]
  family_members FamilyMember[]
  sessions       UserSession[]
}

model Family {
  id         String   @id @default(uuid())
  name       String
  owner_id   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  owner   User           @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  members FamilyMember[]

  @@index([owner_id])
  @@map("families")
}

model FamilyMember {
  id                String    @id @default(uuid())
  family_id         String
  email             String
  user_id           String?
  joined_at         DateTime? @db.Timestamptz(6)
  invite_token      String?   @unique
  invite_expires_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  family Family @relation(fields: [family_id], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([family_id, email])
  @@unique([family_id, user_id])
  @@index([user_id])
  @@map("family_members")
}

enum OwnerType {
  USER
  FAMILY
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum SystemCategoryKey {
  BALANCE_ADJUSTMENT
  INVOICE_PAYMENT
  INSTALLMENT_PREPAYMENT_DISCOUNT
  CARD_REFUND
  CARD_EARLY_PAYMENT
}

enum InvoicePaymentMethod {
  ACCOUNT
  EXTERNAL
}

// `owner_id` points to a user or a family, so it has no FK.
// ledger_balance = initial_balance + every transaction (any date); it is internal and updated atomically with each transaction write (spec 028).
model FinancialAccount {
  id              String        @id @default(uuid())
  name            String
  icon            String
  initial_balance Int           @default(0)
  ledger_balance  Int           @default(0)
  status          AccountStatus @default(ACTIVE)
  owner           OwnerType
  owner_id        String
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  transactions     FinancialTransaction[]
  invoice_payments FinancialInvoicePayment[]

  @@index([owner, owner_id])
  @@map("financial_accounts")
}

enum CreditCardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  OTHER
}

// `owner_id` points to a user or a family, so it has no FK. Not linked to accounts (spec 026).
model FinancialCreditCard {
  id          String          @id @default(uuid())
  title       String
  limit       Int
  brand       CreditCardBrand
  closing_day Int             @db.SmallInt
  due_day     Int             @db.SmallInt
  payment_day Int?            @db.SmallInt
  color       String
  last_digits String?         @db.Char(4)
  status      AccountStatus   @default(ACTIVE)
  owner       OwnerType
  owner_id    String
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  updated_at  DateTime        @updatedAt @db.Timestamptz(6)

  transactions      FinancialTransaction[]
  invoice_payments  FinancialInvoicePayment[]
  installment_plans FinancialInstallmentPlan[]

  @@index([owner, owner_id])
  @@map("financial_credit_cards")
}

enum TransactionType {
  EXPENSE
  INCOME
}

// System categories (system_key set) have no owner, no type and no parent; a CHECK in the migration enforces both shapes.
model FinancialCategory {
  id                  String             @id @default(uuid())
  name                String
  icon                String
  icon_color          String             @default("#000000")
  type                TransactionType?
  parent_id           String?
  depth_level         Int                @default(0)
  owner               OwnerType?
  owner_id            String?
  system_key          SystemCategoryKey? @unique
  exclude_from_totals Boolean            @default(false)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @updatedAt @db.Timestamptz(6)

  parent            FinancialCategory?         @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children          FinancialCategory[]        @relation("CategoryTree")
  transactions      FinancialTransaction[]
  installment_plans FinancialInstallmentPlan[]

  @@index([owner, owner_id])
  @@index([parent_id])
  @@map("financial_categories")
}

// Money is integer cents (BRL implied). `date` is a calendar date (no time, no timezone).
// Both FKs are RESTRICT: an account or category with transactions can never be deleted by accident.
model FinancialTransaction {
  id                       String                @id @default(uuid())
  description              String
  value                    Int
  date                     DateTime              @db.Date
  type                     TransactionType
  account_id               String?
  credit_card_id           String?
  invoice_month            String?               @db.Char(7)
  category_id              String
  installment_plan_id      String?
  installment_number       Int?                  @db.SmallInt
  // Card credits (spec 032): refund links, prepayment, early payment method and its account debit row.
  refunded_transaction_id  String?
  refunded_plan_id         String?
  prepayment_id            String?
  payment_method           InvoicePaymentMethod?
  paid_from_transaction_id String?               @unique
  owner                    OwnerType
  owner_id                 String
  created_at               DateTime              @default(now()) @db.Timestamptz(6)
  updated_at               DateTime              @updatedAt @db.Timestamptz(6)

  account          FinancialAccount?         @relation(fields: [account_id], references: [id], onDelete: Restrict)
  credit_card      FinancialCreditCard?      @relation(fields: [credit_card_id], references: [id], onDelete: Restrict)
  category         FinancialCategory         @relation(fields: [category_id], references: [id], onDelete: Restrict)
  invoice_payment  FinancialInvoicePayment?
  installment_plan FinancialInstallmentPlan? @relation(fields: [installment_plan_id], references: [id], onDelete: Restrict)

  refunded_transaction  FinancialTransaction?           @relation("RefundedPurchase", fields: [refunded_transaction_id], references: [id], onDelete: Restrict)
  refunds               FinancialTransaction[]          @relation("RefundedPurchase")
  refunded_plan         FinancialInstallmentPlan?       @relation("RefundedPlan", fields: [refunded_plan_id], references: [id], onDelete: Restrict)
  prepayment            FinancialInstallmentPrepayment? @relation("PrepaymentRows", fields: [prepayment_id], references: [id], onDelete: Restrict)
  paid_from_transaction FinancialTransaction?           @relation("EarlyPaymentDebit", fields: [paid_from_transaction_id], references: [id], onDelete: Restrict)
  early_payment         FinancialTransaction?           @relation("EarlyPaymentDebit")
  discount_of           FinancialInstallmentPrepayment? @relation("PrepaymentDiscount")

  @@unique([installment_plan_id, installment_number])
  @@index([refunded_transaction_id])
  @@index([refunded_plan_id])
  @@index([prepayment_id])
  @@index([installment_plan_id])
  @@index([credit_card_id, invoice_month])
  @@index([account_id, date])
  @@index([category_id])
  @@index([owner, owner_id, date])
  @@map("financial_transactions")
}

// A transaction belongs to an account XOR a credit card (CHECK in the migration); card purchases carry the stored `invoice_month` (spec 029).
model FinancialInvoicePayment {
  id             String               @id @default(uuid())
  credit_card_id String
  invoice_month  String               @db.Char(7)
  amount         Int
  paid_on        DateTime             @db.Date
  method         InvoicePaymentMethod
  account_id     String?
  transaction_id String?              @unique
  owner          OwnerType
  owner_id       String
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @updatedAt @db.Timestamptz(6)

  credit_card FinancialCreditCard   @relation(fields: [credit_card_id], references: [id], onDelete: Restrict)
  account     FinancialAccount?     @relation(fields: [account_id], references: [id], onDelete: Restrict)
  transaction FinancialTransaction? @relation(fields: [transaction_id], references: [id], onDelete: Restrict)

  @@unique([credit_card_id, invoice_month])
  @@index([owner, owner_id])
  @@map("financial_credit_card_invoice_payments")
}

// Lowercase members on purpose: the client validates against member names, so they must equal the DB/wire values.
enum StockUnit {
  unit
  gram
  kilogram
  liter
  milliliter
}

// `owner_id` points to a user or a family, so it has no FK. Unit values are lowercase in the DB and on the wire.
model StockItem {
  id              String    @id @default(uuid())
  owner           OwnerType
  owner_id        String
  description     String
  quantity        Int
  unit            StockUnit
  brand           String?
  barcode         String?
  notes           String?
  purchase_date   DateTime? @db.Timestamptz(6)
  opening_date    DateTime? @db.Timestamptz(6)
  expiration_date DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([owner, owner_id])
  @@map("stock_items")
}

model UserSession {
  id                  String    @id @default(uuid())
  user_id             String
  token_hash          String    @unique
  previous_token_hash String?   @unique
  retired_token_hash  String?   @unique
  device_name         String?   @db.VarChar(100)
  last_used_at        DateTime  @default(now()) @db.Timestamptz(6)
  rotated_at          DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([last_used_at])
  @@map("user_sessions")
}

model FinancialInstallmentPlan {
  id                String    @id @default(uuid())
  credit_card_id    String
  description       String
  category_id       String
  total_value       Int
  installment_count Int       @db.SmallInt
  date              DateTime  @db.Date
  owner             OwnerType
  owner_id          String
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  credit_card  FinancialCreditCard             @relation(fields: [credit_card_id], references: [id], onDelete: Restrict)
  category     FinancialCategory               @relation(fields: [category_id], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]
  refunds      FinancialTransaction[]          @relation("RefundedPlan")
  prepayment   FinancialInstallmentPrepayment?

  @@index([credit_card_id])
  @@index([category_id])
  @@index([owner, owner_id])
  @@map("financial_installment_plans")
}

// One prepayment per plan (spec 032): `original_months` keeps `{ transactionId: 'YYYY-MM' }` for undo.
model FinancialInstallmentPrepayment {
  id                      String    @id @default(uuid())
  installment_plan_id     String    @unique
  target_invoice_month    String    @db.Char(7)
  original_months         Json
  discount_transaction_id String?   @unique
  date                    DateTime  @db.Date
  owner                   OwnerType
  owner_id                String
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)

  installment_plan     FinancialInstallmentPlan @relation(fields: [installment_plan_id], references: [id], onDelete: Restrict)
  discount_transaction FinancialTransaction?    @relation("PrepaymentDiscount", fields: [discount_transaction_id], references: [id], onDelete: Restrict)
  rows                 FinancialTransaction[]   @relation("PrepaymentRows")

  @@index([owner, owner_id])
  @@map("financial_installment_prepayments")
}
