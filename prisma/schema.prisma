// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password_hash String
  photo_url String?
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt
  families        Family[]
  family_members  FamilyMember[]
}

model Family {
  id         String   @id @default(uuid())
  name       String
  owner_id   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  owner   User           @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  members FamilyMember[]

  @@index([owner_id])
  @@map("families")
}

model FamilyMember {
  id           String    @id @default(uuid())
  family_id    String
  email        String
  user_id      String?
  joined_at    DateTime? @db.Timestamptz(6)
  invite_token String?   @unique
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  family Family @relation(fields: [family_id], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([family_id, email])
  @@index([user_id])
  @@map("family_members")
}

enum OwnerType {
  USER
  FAMILY
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

// `owner_id` points to a user or a family, so it has no FK.
model FinancialAccount {
  id         String        @id @default(uuid())
  name       String
  icon       String
  balance    Int           @default(0)
  status     AccountStatus @default(ACTIVE)
  owner      OwnerType
  owner_id   String
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @updatedAt @db.Timestamptz(6)

  transactions FinancialTransaction[]

  @@index([owner, owner_id])
  @@map("financial_accounts")
}

enum TransactionType {
  EXPENSE
  INCOME
}

model FinancialCategory {
  id          String          @id @default(uuid())
  name        String
  icon        String
  icon_color  String          @default("#000000")
  type        TransactionType
  parent_id   String?
  depth_level Int             @default(0)
  owner       OwnerType
  owner_id    String
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  updated_at  DateTime        @updatedAt @db.Timestamptz(6)

  parent   FinancialCategory?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children FinancialCategory[] @relation("CategoryTree")
  transactions FinancialTransaction[]

  @@index([owner, owner_id])
  @@index([parent_id])
  @@map("financial_categories")
}

// Money is integer cents (BRL implied). `date` is a calendar date (no time, no timezone).
// Both FKs are RESTRICT: an account or category with transactions can never be deleted by accident.
model FinancialTransaction {
  id          String          @id @default(uuid())
  description String
  value       Int
  date        DateTime        @db.Date
  type        TransactionType
  account_id  String
  category_id String
  owner       OwnerType
  owner_id    String
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  updated_at  DateTime        @updatedAt @db.Timestamptz(6)

  account  FinancialAccount  @relation(fields: [account_id], references: [id], onDelete: Restrict)
  category FinancialCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@index([account_id])
  @@index([category_id])
  @@index([owner, owner_id, date])
  @@map("financial_transactions")
}

enum StockUnit {
  UNIT       @map("unit")
  GRAM       @map("gram")
  KILOGRAM   @map("kilogram")
  LITER      @map("liter")
  MILLILITER @map("milliliter")
}

// `owner_id` points to a user or a family, so it has no FK. Unit values are lowercase in the DB and on the wire.
model StockItem {
  id              String    @id @default(uuid())
  owner           OwnerType
  owner_id        String
  description     String
  quantity        Int
  unit            StockUnit
  brand           String?
  barcode         String?
  notes           String?
  purchase_date   DateTime? @db.Timestamptz(6)
  opening_date    DateTime? @db.Timestamptz(6)
  expiration_date DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([owner, owner_id])
  @@map("stock_items")
}
