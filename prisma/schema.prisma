// Spec 115: a recurring income of an asset. Occurrences up to the end of the current month are real
// `investment_incomes` rows (with `series_id` + `occurrence_number`); later ones are projected on read.
// CHECKs in the migration: frequency_interval per unit, ex_date_offset_days 0-90, amount_per_unit > 0, end_date >=
// first_payment_date, account/category present iff with_finance, notes <= 1000, ended_at set with end_reason.
model InvestmentIncomeSeries {
  id                    String                           @id @default(uuid())
  asset_id              String
  type                  InvestmentIncomeType
  first_payment_date    DateTime                         @db.Date
  frequency_unit        RecurrenceUnit
  frequency_interval    Int
  end_date              DateTime?                        @db.Date
  ex_date_offset_days   Int?
  amount_per_unit       Decimal                          @db.Decimal(20, 8)
  currency              String                           @db.VarChar(3)
  with_finance          Boolean
  account_id            String?
  category_id           String?
  notes                 String?
  first_number          Int                              @default(1)
  last_generated_number Int                              @default(0)
  ended_at              DateTime?                        @db.Date
  end_reason            InvestmentIncomeSeriesEndReason?
  created_by            String
  created_at            DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                         @updatedAt @db.Timestamptz(6)

  asset   InvestmentAsset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  incomes InvestmentIncome[]

  @@index([asset_id])
  @@map("investment_income_series")
}

