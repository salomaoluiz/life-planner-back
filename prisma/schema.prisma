model InvestmentCorporateEvent {
  id              String                       @id @default(uuid())
  market          QuoteMarket
  ticker          String                       @db.VarChar(20)
  event_key       String                       @unique
  source          String
  type            InvestmentCorporateEventType
  record_date     DateTime                     @db.Date
  ratio_from      Decimal?                     @db.Decimal(18, 8)
  ratio_to        Decimal?                     @db.Decimal(18, 8)
  bonus_percent   Decimal?                     @db.Decimal(12, 8)
  bonus_unit_cost Decimal?                     @db.Decimal(20, 8)
  currency        String                       @db.VarChar(3)
  fetched_at      DateTime                     @db.Timestamptz(6)

  suggestions InvestmentEventSuggestion[]

  @@index([market, ticker, record_date])
  @@map("investment_corporate_events")
}

model InvestmentEventSuggestion {
  id         String                     @id @default(uuid())
  asset_id   String
  event_id   String
  quantity   Decimal                    @db.Decimal(18, 8)
  status     InvestmentSuggestionStatus @default(PENDING)
  decided_by String?
  decided_at DateTime?                  @db.Timestamptz(6)
  created_at DateTime                   @default(now()) @db.Timestamptz(6)

  asset     InvestmentAsset          @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  event     InvestmentCorporateEvent @relation(fields: [event_id], references: [id])
  operation InvestmentOperation?

  @@unique([asset_id, event_id])
  @@index([asset_id, status])
  @@map("investment_event_suggestions")
}

// Spec 119: header of a split transaction; the parts are `financial_transactions` rows with `split_id`.
model FinancialSplit {
  id                String    @id @default(uuid())
  description       String
  notes             String?
  date              DateTime  @db.Date
  account_id        String?
  credit_card_id    String?
  invoice_month     String?   @db.Char(7)
  paid              Boolean?
  currency          String    @default("BRL") @db.VarChar(3)
  recurrence_id     String?
  occurrence_number Int?
  owner             OwnerType
  owner_id          String
  created_by        String
  stock_purchase_id String?   @unique @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  account        FinancialAccount?      @relation(fields: [account_id], references: [id], onDelete: Restrict)
  credit_card    FinancialCreditCard?   @relation(fields: [credit_card_id], references: [id], onDelete: Restrict)
  recurrence     FinancialRecurrence?   @relation(fields: [recurrence_id], references: [id], onDelete: Restrict)
  transactions   FinancialTransaction[]
  stock_purchase StockPurchase?         @relation("PurchaseSplit", fields: [stock_purchase_id], references: [id], onDelete: SetNull)

  @@unique([recurrence_id, occurrence_number])
  @@index([owner, owner_id, date])
  @@index([account_id])
  @@index([credit_card_id, invoice_month])
  @@map("financial_splits")
}

// Spec 119: the parts of a split series, copied to every occurrence.
model FinancialRecurrencePart {
  id            String          @id @default(uuid())
  recurrence_id String
  type          TransactionType
  category_id   String
  value         Int
  description   String?
  sort_order    Int             @db.SmallInt

  recurrence FinancialRecurrence          @relation(fields: [recurrence_id], references: [id], onDelete: Cascade)
  category   FinancialCategory            @relation(fields: [category_id], references: [id], onDelete: Restrict)
  tags       FinancialRecurrencePartTag[]

  @@unique([recurrence_id, sort_order])
  @@index([category_id])
  @@map("financial_recurrence_parts")
}

model FinancialRecurrencePartTag {
  part_id  String
  tag_id   String
  position Int    @db.SmallInt

  part FinancialRecurrencePart @relation(fields: [part_id], references: [id], onDelete: Cascade)
  tag  FinancialTag            @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([part_id, tag_id])
  @@index([tag_id])
  @@map("financial_recurrence_part_tags")
}

enum StockPurchaseStatus {
  OPEN
  ENDED
  CLOSED
  DISCARDED
}

enum PurchasePriceInput {
  UNIT
  LINE
}

enum PurchaseRowState {
  IN_CART
  NOT_FOUND
}

// Spec 120: markets of an owner (archived, never deleted: purchases and prices point to them).
model StockMarket {
  id           String        @id @default(uuid())
  owner        OwnerType
  owner_id     String
  name         String        @db.VarChar(60)
  neighborhood String?       @db.VarChar(60)
  status       AccountStatus @default(ACTIVE)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @updatedAt @db.Timestamptz(6)

  lists         StockShoppingList[]
  purchases     StockPurchase[]
  price_history StockPriceHistory[]

  @@index([owner, owner_id])
  @@map("stock_markets")
}

model StockPurchase {
  id                  String              @id @db.Uuid
  list_id             String
  owner               OwnerType
  owner_id            String
  market_id           String
  status              StockPurchaseStatus @default(OPEN)
  started_by          String?
  closed_by           String?
  started_at          DateTime            @default(now()) @db.Timestamptz(6)
  ended_at            DateTime?           @db.Timestamptz(6)
  closed_at           DateTime?           @db.Timestamptz(6)
  last_activity_at    DateTime            @default(now()) @db.Timestamptz(6)
  closing_by          String?
  closing_at          DateTime?           @db.Timestamptz(6)
  purchase_date       DateTime            @db.Date
  receipt_total_cents Int?
  currency            String              @default("BRL") @db.VarChar(3)
  account_id          String?
  credit_card_id      String?
  invoice_month       String?             @db.Char(7)
  split_id            String?
  transaction_id      String?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @updatedAt @db.Timestamptz(6)

  list          StockShoppingList      @relation(fields: [list_id], references: [id], onDelete: Restrict)
  market        StockMarket            @relation(fields: [market_id], references: [id], onDelete: Restrict)
  starter       User?                  @relation("PurchaseStarter", fields: [started_by], references: [id], onDelete: SetNull)
  rows          StockPurchaseRow[]
  price_history StockPriceHistory[]
  split         FinancialSplit?        @relation("PurchaseSplit")
  transactions  FinancialTransaction[] @relation("PurchaseTransaction")

  @@index([list_id, status])
  @@index([owner, owner_id, status, last_activity_at])
  @@map("stock_purchases")
}

model StockPurchaseRow {
  id                String              @id @db.Uuid
  purchase_id       String              @db.Uuid
  list_row_id       String?
  item_id           String?
  description       String?             @db.VarChar(100)
  barcode           String?             @db.VarChar(64)
  unit              StockUnit?
  quantity          Decimal?            @db.Decimal(14, 3)
  unit_price_cents  Int?
  line_total_cents  Int?
  price_input       PurchasePriceInput?
  unknown_price     Boolean             @default(false)
  expiration_date   DateTime?           @db.Date
  state             PurchaseRowState    @default(IN_CART)
  entry_movement_id String?
  checked_by        String?
  checked_at        DateTime            @default(now()) @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @updatedAt @db.Timestamptz(6)

  purchase       StockPurchase  @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  item           StockItem?     @relation(fields: [item_id], references: [id], onDelete: SetNull)
  entry_movement StockMovement? @relation(fields: [entry_movement_id], references: [id], onDelete: SetNull)
  checker        User?          @relation("PurchaseRowChecker", fields: [checked_by], references: [id], onDelete: SetNull)

  @@index([purchase_id])
  @@index([list_row_id])
  @@map("stock_purchase_rows")
}

model StockPurchaseEvent {
  id          BigInt   @id @default(autoincrement())
  list_id     String
  purchase_id String   @db.Uuid
  type        String   @db.VarChar(40)
  payload     Json
  client_id   String?  @unique @db.Uuid
  user_id     String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([list_id, id])
  @@map("stock_purchase_events")
}

model StockPriceHistory {
  id               String   @id @default(uuid())
  item_id          String
  market_id        String
  purchase_id      String   @db.Uuid
  date             DateTime @db.Date
  unit_price_cents Int
  currency         String   @default("BRL") @db.VarChar(3)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  item     StockItem     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  market   StockMarket   @relation(fields: [market_id], references: [id], onDelete: Restrict)
  purchase StockPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@index([item_id, market_id, date(sort: Desc)])
  @@index([item_id, date(sort: Desc)])
  @@map("stock_price_history")
}

enum AiUsageKind {
  LIGHT
  SEARCH
}

// Spec 121 FR 21: calls to the AI provider per user, kind and calendar day.
model AiUsageDaily {
  user_id    String
  day        DateTime    @db.Date
  kind       AiUsageKind
  count      Int         @default(0)
  updated_at DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, day, kind])
  @@map("ai_usage_daily")
}

// Spec 124: notification center, preferences and push delivery. Everything belongs to one user (cascade on delete).
enum PushProvider {
  EXPO
  WEB_PUSH
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationType {
  STOCK_EXPIRING
  STOCK_OPENED_EXPIRING
  FINANCE_BILL_DUE
  FINANCE_INVOICE_DUE
}

enum NotificationKind {
  SUMMARY
  URGENT
}

enum NotificationModule {
  STOCK
  FINANCE
}

enum NotificationItemState {
  DUE_TODAY
  OVERDUE
  UPCOMING
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  INVALID
}

model NotificationDevice {
  id           String         @id @default(uuid())
  user_id      String
  provider     PushProvider
  platform     DevicePlatform
  token        String         @unique
  web_p256dh   String?
  web_auth     String?
  name         String         @db.VarChar(60)
  enabled      Boolean        @default(true)
  last_seen_at DateTime       @default(now()) @db.Timestamptz(6)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @updatedAt @db.Timestamptz(6)

  user       User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([user_id])
  @@index([last_seen_at])
  @@map("notification_devices")
}

model NotificationPreference {
  user_id            String             @id
  disabled_types     NotificationType[] @default([])
  bill_lead_days     Int                @default(3) @db.SmallInt
  invoice_lead_days  Int                @default(3) @db.SmallInt
  summary_minute     Int                @default(480) @db.SmallInt
  quiet_start_minute Int                @default(1320) @db.SmallInt
  quiet_end_minute   Int                @default(420) @db.SmallInt
  time_zone          String             @default("America/Sao_Paulo") @db.VarChar(64)
  locale             String             @default("pt-BR") @db.VarChar(5)
  last_summary_on    DateTime?          @db.Date
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([last_summary_on])
  @@index([summary_minute])
  @@map("notification_preferences")
}

model NotificationFamilyPreference {
  user_id   String
  family_id String
  enabled   Boolean @default(true)

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  family Family @relation(fields: [family_id], references: [id], onDelete: Cascade)

  @@id([user_id, family_id])
  @@map("notification_family_preferences")
}

model Notification {
  id         String           @id @default(uuid())
  user_id    String
  kind       NotificationKind
  local_date DateTime         @db.Date
  title      String           @db.VarChar(120)
  body       String           @db.VarChar(300)
  read_at    DateTime?        @db.Timestamptz(6)
  created_at DateTime         @default(now()) @db.Timestamptz(6)

  user       User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      NotificationItem[]
  deliveries NotificationDelivery[]

  @@index([created_at])
  @@map("notifications")
}

model NotificationItem {
  id              String                @id @default(uuid())
  notification_id String
  user_id         String
  type            NotificationType
  module          NotificationModule
  state           NotificationItemState
  source_id       String                @db.VarChar(80)
  owner           OwnerType
  owner_id        String
  due_date        DateTime              @db.Date
  dedupe_key      String                @db.VarChar(160)
  snapshot        Json
  route           String                @db.VarChar(200)
  position        Int                   @db.SmallInt

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, dedupe_key])
  @@index([notification_id])
  @@index([owner, owner_id])
  @@map("notification_items")
}

model NotificationDelivery {
  id              String         @id @default(uuid())
  notification_id String
  device_id       String
  status          DeliveryStatus @default(PENDING)
  attempts        Int            @default(0) @db.SmallInt
  next_attempt_at DateTime       @default(now()) @db.Timestamptz(6)
  ticket_id       String?        @db.VarChar(64)
  error           String?        @db.VarChar(200)
  sent_at         DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)

  notification Notification       @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  device       NotificationDevice @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@index([notification_id])
  @@map("notification_deliveries")
}
