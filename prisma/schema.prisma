// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  // Lets a bounded read with relations run as ONE joined query (`relationLoadStrategy: 'join'`).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                    @id @default(uuid())
  email            String                    @unique
  name             String
  password_hash    String
  photo_url        String?
  created_at       DateTime?                 @default(now())
  updated_at       DateTime?                 @updatedAt
  families         Family[]
  family_members   FamilyMember[]
  sessions         UserSession[]
  account_favorite FinancialAccountFavorite?
}

model Family {
  id         String        @id @default(uuid())
  name       String
  owner_id   String
  status     AccountStatus @default(ACTIVE)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @updatedAt @db.Timestamptz(6)

  owner   User           @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  members FamilyMember[]

  @@index([owner_id])
  @@map("families")
}

model FamilyMember {
  id                String    @id @default(uuid())
  family_id         String
  email             String
  user_id           String?
  joined_at         DateTime? @db.Timestamptz(6)
  invite_token      String?   @unique
  invite_expires_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  family Family @relation(fields: [family_id], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([family_id, email])
  @@unique([family_id, user_id])
  @@index([user_id])
  @@map("family_members")
}

enum OwnerType {
  USER
  FAMILY
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

// Spec 101: what the account is. Every type behaves like an account (same totals and rules).
enum AccountType {
  CHECKING
  SAVINGS
  BROKERAGE
  CASH
  OTHER
}

enum SystemCategoryKey {
  BALANCE_ADJUSTMENT
  INVOICE_PAYMENT
  INSTALLMENT_PREPAYMENT_DISCOUNT
  CARD_REFUND
  CARD_EARLY_PAYMENT
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_FEE
  INVESTMENT_CONTRIBUTION
  INVESTMENT_REDEMPTION
}

enum InvoicePaymentMethod {
  ACCOUNT
  EXTERNAL
}

// `owner_id` points to a user or a family, so it has no FK.
// ledger_balance = initial_balance + every PAID account transaction (any date, spec 033); it is internal and updated atomically with each transaction write (spec 028).
model FinancialAccount {
  id              String        @id @default(uuid())
  name            String
  icon            String
  initial_balance Int           @default(0)
  ledger_balance  Int           @default(0)
  currency        String        @default("BRL") @db.VarChar(3)
  status          AccountStatus @default(ACTIVE)
  type            AccountType   @default(CHECKING)
  archived_at     DateTime?     @db.Timestamptz(6)
  owner           OwnerType
  owner_id        String
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)

  transactions          FinancialTransaction[]
  recurrences           FinancialRecurrence[]
  incoming_series       FinancialRecurrence[]      @relation("TransferSeriesDestination")
  transfers_out         FinancialTransfer[]        @relation("TransferFrom")
  transfers_in          FinancialTransfer[]        @relation("TransferTo")
  invoice_payments      FinancialInvoicePayment[]
  payment_cards         FinancialCreditCard[]      @relation("CardPaymentAccount")
  favorites             FinancialAccountFavorite[]
  investment_operations InvestmentOperation[]

  @@index([owner, owner_id])
  @@map("financial_accounts")
}

// Spec 094: at most one favorite account per user (PK on user_id); the account is only readable by that user.
model FinancialAccountFavorite {
  user_id    String   @id
  account_id String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  user    User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account FinancialAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@map("financial_account_favorites")
}

enum CreditCardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  OTHER
}

// `owner_id` points to a user or a family, so it has no FK. Not linked to accounts (spec 026).
model FinancialCreditCard {
  id          String          @id @default(uuid())
  title       String
  limit       Int
  brand       CreditCardBrand
  closing_day Int             @db.SmallInt
  due_day     Int             @db.SmallInt
  payment_day Int?            @db.SmallInt
  color       String
  last_digits String?         @db.Char(4)
  currency    String          @default("BRL") @db.VarChar(3)
  status      AccountStatus   @default(ACTIVE)
  archived_at DateTime?       @db.Timestamptz(6)
  owner       OwnerType
  owner_id    String
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  updated_at  DateTime        @updatedAt @db.Timestamptz(6)

  // Optional account that pays the invoice in the day balance forecast (spec 035).
  payment_account_id String?
  payment_account    FinancialAccount? @relation("CardPaymentAccount", fields: [payment_account_id], references: [id], onDelete: SetNull)

  transactions      FinancialTransaction[]
  invoice_payments  FinancialInvoicePayment[]
  installment_plans FinancialInstallmentPlan[]
  recurrences       FinancialRecurrence[]
  invoice_totals    FinancialCardInvoiceTotal[]

  @@index([owner, owner_id])
  @@index([payment_account_id])
  @@map("financial_credit_cards")
}

enum TransactionType {
  EXPENSE
  INCOME
}

// System categories (system_key set) have no owner, no type and no parent; a CHECK in the migration enforces both shapes.
model FinancialCategory {
  id                  String             @id @default(uuid())
  name                String
  icon                String
  icon_color          String             @default("#000000")
  type                TransactionType?
  parent_id           String?
  depth_level         Int                @default(0)
  owner               OwnerType?
  owner_id            String?
  system_key          SystemCategoryKey? @unique
  exclude_from_totals Boolean            @default(false)
  // Spec 038: an ALL category follows every scope of `creator_id` (Personal + families); `owner/owner_id` stays the
  // creator's Personal scope and `scopes` lists them all. Single-scope rows keep `all_scopes = false`.
  all_scopes          Boolean            @default(false)
  creator_id          String?
  // Spec 041: ARCHIVED categories leave the pickers that create or change records; history is kept.
  status              AccountStatus      @default(ACTIVE)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @updatedAt @db.Timestamptz(6)

  scopes            FinancialCategoryScope[]
  parent            FinancialCategory?         @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children          FinancialCategory[]        @relation("CategoryTree")
  transactions      FinancialTransaction[]
  installment_plans FinancialInstallmentPlan[]
  recurrences       FinancialRecurrence[]

  @@index([owner, owner_id])
  @@index([parent_id])
  @@map("financial_categories")
}

model FinancialCategoryScope {
  id          String    @id @default(uuid())
  category_id String
  owner       OwnerType
  owner_id    String

  category FinancialCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([category_id, owner, owner_id])
  @@index([owner, owner_id])
  @@map("financial_category_scopes")
}

// Money is integer cents (BRL implied). `date` is a calendar date (no time, no timezone).
// Both FKs are RESTRICT: an account or category with transactions can never be deleted by accident.
model FinancialTransaction {
  id                       String                @id @default(uuid())
  description              String
  // Spec 059: free text, trimmed, at most 1000 characters (CHECK in the migration); NULL when empty.
  notes                    String?
  value                    Int
  date                     DateTime              @db.Date
  type                     TransactionType
  account_id               String?
  credit_card_id           String?
  invoice_month            String?               @db.Char(7)
  // Account rows only (spec 033); card rows are NULL and derive their status from the invoice.
  paid                     Boolean?
  category_id              String
  installment_plan_id      String?
  installment_number       Int?                  @db.SmallInt
  // Recurring series (spec 034): both set or both null; `occurrence_number` is the position in the series.
  recurrence_id            String?
  occurrence_number        Int?
  // Card credits (spec 032): refund links, prepayment, early payment method and its account debit row.
  refunded_transaction_id  String?
  refunded_plan_id         String?
  prepayment_id            String?
  payment_method           InvoicePaymentMethod?
  paid_from_transaction_id String?               @unique
  // Spec 096: a card EXPENSE not charged yet (CHECK in the migration); counts apart from the effective totals.
  projected                Boolean               @default(false)
  // Spec 098: out, in and fee rows of a transfer; they change only through the transfer.
  transfer_id              String?
  // Spec 107: a row managed by another module (investment income); finance never edits or deletes it directly.
  external_lock            TransactionExternalLock?
  currency                 String                @default("BRL") @db.VarChar(3)
  owner                    OwnerType
  owner_id                 String
  created_at               DateTime              @default(now()) @db.Timestamptz(3)
  updated_at               DateTime              @updatedAt @db.Timestamptz(6)

  account              FinancialAccount?         @relation(fields: [account_id], references: [id], onDelete: Restrict)
  credit_card          FinancialCreditCard?      @relation(fields: [credit_card_id], references: [id], onDelete: Restrict)
  category             FinancialCategory         @relation(fields: [category_id], references: [id], onDelete: Restrict)
  invoice_payment      FinancialInvoicePayment?
  installment_plan     FinancialInstallmentPlan? @relation(fields: [installment_plan_id], references: [id], onDelete: Restrict)
  recurrence           FinancialRecurrence?      @relation(fields: [recurrence_id], references: [id], onDelete: Restrict)
  transfer             FinancialTransfer?        @relation(fields: [transfer_id], references: [id], onDelete: Restrict)
  investment_operation InvestmentOperation?
  investment_income    InvestmentIncome?

  refunded_transaction  FinancialTransaction?           @relation("RefundedPurchase", fields: [refunded_transaction_id], references: [id], onDelete: Restrict)
  refunds               FinancialTransaction[]          @relation("RefundedPurchase")
  refunded_plan         FinancialInstallmentPlan?       @relation("RefundedPlan", fields: [refunded_plan_id], references: [id], onDelete: Restrict)
  prepayment            FinancialInstallmentPrepayment? @relation("PrepaymentRows", fields: [prepayment_id], references: [id], onDelete: Restrict)
  paid_from_transaction FinancialTransaction?           @relation("EarlyPaymentDebit", fields: [paid_from_transaction_id], references: [id], onDelete: Restrict)
  early_payment         FinancialTransaction?           @relation("EarlyPaymentDebit")
  discount_of           FinancialInstallmentPrepayment? @relation("PrepaymentDiscount")
  tags                  FinancialTransactionTag[]

  @@unique([installment_plan_id, installment_number])
  @@unique([recurrence_id, occurrence_number])
  @@index([refunded_transaction_id])
  @@index([refunded_plan_id])
  @@index([prepayment_id])
  @@index([credit_card_id, invoice_month])
  @@index([account_id, date])
  @@index([category_id])
  @@index([transfer_id])
  @@index([owner, owner_id, date])
  @@map("financial_transactions")
}

// A transaction belongs to an account XOR a credit card (CHECK in the migration); card purchases carry the stored `invoice_month` (spec 029).
model FinancialInvoicePayment {
  id             String               @id @default(uuid())
  credit_card_id String
  invoice_month  String               @db.Char(7)
  amount         Int
  paid_on        DateTime             @db.Date
  method         InvoicePaymentMethod
  account_id     String?
  transaction_id String?              @unique
  owner          OwnerType
  owner_id       String
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @updatedAt @db.Timestamptz(6)

  credit_card FinancialCreditCard   @relation(fields: [credit_card_id], references: [id], onDelete: Restrict)
  account     FinancialAccount?     @relation(fields: [account_id], references: [id], onDelete: Restrict)
  transaction FinancialTransaction? @relation(fields: [transaction_id], references: [id], onDelete: Restrict)

  @@unique([credit_card_id, invoice_month])
  @@index([owner, owner_id])
  @@map("financial_credit_card_invoice_payments")
}

// Spec 090: stored totals of the card rows of each (card, invoice month), kept by the write transactions and read by every
// card invoice computation (spec 091). Aggregation: every card row, no exclusions.
model FinancialCardInvoiceTotal {
  credit_card_id   String
  invoice_month    String   @db.Char(7)
  income           Int      @default(0)
  expense          Int      @default(0)
  early_paid       Int      @default(0)
  purchase_count   Int      @default(0)
  // Spec 096: `income/expense/early_paid/purchase_count` count effective rows only.
  projected_amount Int      @default(0)
  projected_count  Int      @default(0)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  credit_card FinancialCreditCard @relation(fields: [credit_card_id], references: [id], onDelete: Cascade)

  @@id([credit_card_id, invoice_month])
  @@map("financial_card_invoice_totals")
}

// Spec 092: bumped (by database triggers, once per transaction and owner) by every write that changes what the owner
// reads; the finance GET routes build their ETag from it. A missing row means version 0.
model FinanceOwnerVersion {
  owner      OwnerType
  owner_id   String
  version    BigInt    @default(1)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)

  @@id([owner, owner_id])
  @@map("finance_owner_versions")
}

// Lowercase members on purpose: the client validates against member names, so they must equal the DB/wire values.
enum StockUnit {
  unit
  gram
  kilogram
  liter
  milliliter
}

// `owner_id` points to a user or a family, so it has no FK. Unit values are lowercase in the DB and on the wire.
model StockItem {
  id              String    @id @default(uuid())
  owner           OwnerType
  owner_id        String
  description     String
  quantity        Int
  unit            StockUnit
  brand           String?
  barcode         String?
  notes           String?
  purchase_date   DateTime? @db.Timestamptz(6)
  opening_date    DateTime? @db.Timestamptz(6)
  expiration_date DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([owner, owner_id])
  @@map("stock_items")
}

model UserSession {
  id                  String    @id @default(uuid())
  user_id             String
  token_hash          String    @unique
  previous_token_hash String?   @unique
  retired_token_hash  String?   @unique
  device_name         String?   @db.VarChar(100)
  last_used_at        DateTime  @default(now()) @db.Timestamptz(6)
  rotated_at          DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([last_used_at])
  @@map("user_sessions")
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceStatus {
  ACTIVE
  ENDED
}

// A recurring transaction series (spec 034): the template plus the schedule; real rows live in `financial_transactions`.
// CHECKs in the migration: account XOR card, end_date >= start_date.
model FinancialRecurrence {
  id                    String              @id @default(uuid())
  description           String
  // Spec 059: free text, trimmed, at most 1000 characters (CHECK in the migration); NULL when empty.
  notes                 String?
  value                 Int
  type                  TransactionType
  category_id           String
  account_id            String?
  credit_card_id        String?
  // Spec 098: set = transfer series (`value` is the amount out); `amount_in` only when both currencies are equal.
  to_account_id         String?
  amount_in             Int?
  frequency             RecurrenceFrequency
  start_date            DateTime            @db.Date
  end_date              DateTime?           @db.Date
  first_number          Int                 @default(1)
  last_generated_number Int                 @default(0)
  next_occurrence_date  DateTime?           @db.Date
  skipped_numbers       Int[]               @default([])
  status                RecurrenceStatus    @default(ACTIVE)
  // Spec 096: every occurrence of a card EXPENSE series is born projected (CHECK in the migration).
  projected             Boolean             @default(false)
  currency              String              @default("BRL") @db.VarChar(3)
  owner                 OwnerType
  owner_id              String
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime            @updatedAt @db.Timestamptz(6)

  category     FinancialCategory        @relation(fields: [category_id], references: [id], onDelete: Restrict)
  account      FinancialAccount?        @relation(fields: [account_id], references: [id], onDelete: Restrict)
  credit_card  FinancialCreditCard?     @relation(fields: [credit_card_id], references: [id], onDelete: Restrict)
  to_account   FinancialAccount?        @relation("TransferSeriesDestination", fields: [to_account_id], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]
  transfers    FinancialTransfer[]
  tags         FinancialRecurrenceTag[]

  @@index([owner, owner_id, status, next_occurrence_date])
  @@index([account_id])
  @@index([to_account_id])
  @@index([credit_card_id])
  @@index([category_id])
  @@map("financial_recurrences")
}

model FinancialInstallmentPlan {
  id                String    @id @default(uuid())
  credit_card_id    String
  description       String
  // Spec 059: free text, trimmed, at most 1000 characters (CHECK in the migration); NULL when empty.
  notes             String?
  category_id       String
  total_value       Int
  installment_count Int       @db.SmallInt
  date              DateTime  @db.Date
  currency          String    @default("BRL") @db.VarChar(3)
  owner             OwnerType
  owner_id          String
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  credit_card  FinancialCreditCard             @relation(fields: [credit_card_id], references: [id], onDelete: Restrict)
  category     FinancialCategory               @relation(fields: [category_id], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]
  refunds      FinancialTransaction[]          @relation("RefundedPlan")
  prepayment   FinancialInstallmentPrepayment?

  @@index([credit_card_id])
  @@index([category_id])
  @@index([owner, owner_id])
  @@map("financial_installment_plans")
}

// One prepayment per plan (spec 032): `original_months` keeps `{ transactionId: 'YYYY-MM' }` for undo.
model FinancialInstallmentPrepayment {
  id                      String    @id @default(uuid())
  installment_plan_id     String    @unique
  target_invoice_month    String    @db.Char(7)
  original_months         Json
  discount_transaction_id String?   @unique
  date                    DateTime  @db.Date
  owner                   OwnerType
  owner_id                String
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)

  installment_plan     FinancialInstallmentPlan @relation(fields: [installment_plan_id], references: [id], onDelete: Restrict)
  discount_transaction FinancialTransaction?    @relation("PrepaymentDiscount", fields: [discount_transaction_id], references: [id], onDelete: Restrict)
  rows                 FinancialTransaction[]   @relation("PrepaymentRows")

  @@index([owner, owner_id])
  @@map("financial_installment_prepayments")
}

// Spec 043: tags mirror categories without hierarchy. An ALL tag follows every scope of `creator_id`;
// `owner/owner_id` is the creator's Personal scope and `scopes` lists them all. A partial unique index in the
// migration backs the single-scope name rule (case-insensitive).
model FinancialTag {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(30)
  owner      OwnerType
  owner_id   String
  all_scopes Boolean   @default(false)
  creator_id String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)

  scopes       FinancialTagScope[]
  transactions FinancialTransactionTag[]
  recurrences  FinancialRecurrenceTag[]

  @@index([owner, owner_id])
  @@map("financial_tags")
}

model FinancialTagScope {
  id       String    @id @default(uuid())
  tag_id   String
  owner    OwnerType
  owner_id String

  tag FinancialTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([tag_id, owner, owner_id])
  @@index([owner, owner_id])
  @@map("financial_tag_scopes")
}

model FinancialTransactionTag {
  transaction_id String
  tag_id         String
  position       Int    @db.SmallInt

  transaction FinancialTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  tag         FinancialTag         @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([transaction_id, tag_id])
  @@index([tag_id])
  @@map("financial_transaction_tags")
}

model FinancialRecurrenceTag {
  recurrence_id String
  tag_id        String
  position      Int    @db.SmallInt

  recurrence FinancialRecurrence @relation(fields: [recurrence_id], references: [id], onDelete: Cascade)
  tag        FinancialTag        @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([recurrence_id, tag_id])
  @@index([tag_id])
  @@map("financial_recurrence_tags")
}

// Spec 058: curated icon catalog. `search_text` / `search` are generated columns (see the migration), queried only
// with raw SQL, so Prisma never writes them.
model CategoryIcon {
  name        String                   @id
  label_pt    String
  label_en    String
  group_key   String
  keywords    String[]
  common      Boolean                  @default(false)
  sort        Int
  search_text Unsupported("text")?
  search      Unsupported("tsvector")?

  @@index([search], map: "category_icons_search_idx", type: Gin)
  @@map("category_icons")
}

// Spec 098: one movement between two accounts. Amounts in cents of each account's currency; `amount_in` is NULL only for an
// unpaid occurrence of a different-currency series. The account FKs are SetNull so deleting a user keeps the family side.
// CHECKs in the migration: from <> to, date_in >= date_out, amount_out > 0, amount_in > 0 or NULL, fee > 0 or NULL.
model FinancialTransfer {
  id                String   @id @default(uuid())
  description       String
  notes             String?
  from_account_id   String?
  to_account_id     String?
  amount_out        Int
  amount_in         Int?
  currency_out      String   @db.VarChar(3)
  currency_in       String   @db.VarChar(3)
  date_out          DateTime @db.Date
  date_in           DateTime @db.Date
  paid              Boolean  @default(false)
  fee               Int?
  recurrence_id     String?
  occurrence_number Int?
  created_by        String
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  from_account FinancialAccount?      @relation("TransferFrom", fields: [from_account_id], references: [id], onDelete: SetNull)
  to_account   FinancialAccount?      @relation("TransferTo", fields: [to_account_id], references: [id], onDelete: SetNull)
  recurrence   FinancialRecurrence?   @relation(fields: [recurrence_id], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]

  @@unique([recurrence_id, occurrence_number])
  @@index([from_account_id])
  @@index([to_account_id])
  @@map("financial_transfers")
}

enum InvestmentAssetClass {
  BR_STOCK
  BR_REIT
  FOREIGN_STOCK
  FIXED_INCOME
  PRIVATE
}

enum InvestmentAssetStatus {
  ACTIVE
  ARCHIVED
}

enum InvestmentOperationType {
  BUY
  SELL
}

enum InvestmentFeeKind {
  BROKERAGE
  EXCHANGE_FEES
  FX_IOF
  INCOME_TAX
  IOF
  OTHER
}

enum InvestmentFixedIncomeProduct {
  CDB
  LCI
  LCA
  CRI
  CRA
  DEBENTURE
  INCENTIVIZED_DEBENTURE
  TREASURY
  OTHER
}

enum InvestmentFixedIncomeLiquidity {
  DAILY
  AT_MATURITY
  GRACE_PERIOD
}

enum InvestmentFixedIncomeRateMode {
  PREFIXED
  CDI_PERCENT
  IPCA_PLUS
}

enum InvestmentFixedIncomeRedemptionKind {
  PARTIAL
  TOTAL
}

enum InvestmentValuationSource {
  MANUAL
}

// Spec 102: investments. Quantities and unit prices are exact decimals; every total is integer cents.
enum QuoteMarket {
  B3
  US
}

enum QuoteSource {
  BRAPI
  FINNHUB
}

// Market data (spec 104): global, no owner.
model InvestmentQuote {
  id             String      @id @default(uuid())
  market         QuoteMarket
  ticker         String      @db.VarChar(20)
  currency       String      @db.VarChar(3)
  price          Decimal     @db.Decimal(20, 8)
  previous_close Decimal?    @db.Decimal(20, 8)
  change_percent Decimal?    @db.Decimal(9, 4)
  day_high       Decimal?    @db.Decimal(20, 8)
  day_low        Decimal?    @db.Decimal(20, 8)
  quoted_at      DateTime    @db.Timestamptz(6)
  fetched_at     DateTime    @db.Timestamptz(6)
  source         QuoteSource
  last_error_at  DateTime?   @db.Timestamptz(6)
  missing_days   Int         @default(0)
  unavailable    Boolean     @default(false)
  name           String?
  logo_url       String?

  @@unique([market, ticker])
  @@map("investment_quotes")
}

model InvestmentPriceHistory {
  id         String      @id @default(uuid())
  market     QuoteMarket
  ticker     String      @db.VarChar(20)
  date       DateTime    @db.Date
  close      Decimal     @db.Decimal(20, 8)
  source     QuoteSource
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @updatedAt @db.Timestamptz(6)

  @@unique([market, ticker, date])
  @@map("investment_price_history")
}

model FxRate {
  id        String   @id @default(uuid())
  pair      String   @unique
  rate      Decimal  @db.Decimal(12, 6)
  quoted_at DateTime @db.Timestamptz(6)
  source    String

  @@map("fx_rates")
}

model FxRateHistory {
  id     String   @id @default(uuid())
  pair   String
  date   DateTime @db.Date
  rate   Decimal  @db.Decimal(12, 6)
  source String

  @@unique([pair, date])
  @@map("fx_rate_history")
}

enum TransactionExternalLock {
  INVESTMENT
}

enum InvestmentIncomeType {
  DIVIDEND
  JCP
  YIELD
  INTEREST
  OTHER
}

enum InvestmentSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  DISMISSED
}

model InvestmentAsset {
  id          String                @id @default(uuid())
  asset_class InvestmentAssetClass
  ticker      String?               @db.VarChar(20)
  name        String                @db.VarChar(100)
  currency    String                @db.VarChar(3)
  status      InvestmentAssetStatus @default(ACTIVE)
  archived_at DateTime?             @db.Timestamptz(6)
  owner       OwnerType
  owner_id    String
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @updatedAt @db.Timestamptz(6)

  operations               InvestmentOperation[]
  valuations               InvestmentValuation[]
  fixed_income_terms       InvestmentFixedIncomeTerms?
  fixed_income_rates       InvestmentFixedIncomeRate[]
  fixed_income_adjustments InvestmentFixedIncomeAdjustment[]
  incomes                  InvestmentIncome[]
  income_suggestions       InvestmentIncomeSuggestion[]

  @@index([owner, owner_id])
  @@map("investment_assets")
}

model InvestmentOperation {
  id                   String                               @id @default(uuid())
  asset_id             String
  type                 InvestmentOperationType
  date                 DateTime                             @db.Date
  quantity             Decimal                              @db.Decimal(18, 8)
  unit_price           Decimal                              @db.Decimal(20, 8)
  gross                Int
  fees_total           Int
  total                Int
  generate_transaction Boolean
  account_id           String?
  transaction_id       String?                              @unique
  fx_rate              Decimal?                             @db.Decimal(12, 6)
  redemption_kind      InvestmentFixedIncomeRedemptionKind?
  net_amount           Int?
  created_at           DateTime                             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                             @updatedAt @db.Timestamptz(6)

  asset       InvestmentAsset          @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  account     FinancialAccount?        @relation(fields: [account_id], references: [id], onDelete: SetNull)
  transaction FinancialTransaction?    @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  fees        InvestmentOperationFee[]

  @@index([asset_id, date, created_at, id])
  @@index([account_id])
  @@map("investment_operations")
}

model InvestmentOperationFee {
  id           String            @id @default(uuid())
  operation_id String
  kind         InvestmentFeeKind
  amount       Int
  description  String?           @db.VarChar(60)

  operation InvestmentOperation @relation(fields: [operation_id], references: [id], onDelete: Cascade)

  @@index([operation_id])
  @@map("investment_operation_fees")
}

model InvestmentValuation {
  id         String                    @id @default(uuid())
  asset_id   String
  date       DateTime                  @db.Date
  unit_price Decimal                   @db.Decimal(20, 8)
  source     InvestmentValuationSource @default(MANUAL)
  created_at DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at DateTime                  @updatedAt @db.Timestamptz(6)

  asset InvestmentAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, date])
  @@map("investment_valuations")
}

// Spec 105: fixed income calculated from the rate.
model InvestmentFixedIncomeTerms {
  asset_id       String                         @id
  product        InvestmentFixedIncomeProduct
  tax_exempt     Boolean
  maturity_date  DateTime                       @db.Date
  liquidity      InvestmentFixedIncomeLiquidity
  liquidity_date DateTime?                      @db.Date
  created_at     DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                       @updatedAt @db.Timestamptz(6)

  asset InvestmentAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([maturity_date])
  @@map("investment_fixed_income_terms")
}

model InvestmentFixedIncomeRate {
  id             String                        @id @default(uuid())
  asset_id       String
  start_date     DateTime                      @db.Date
  mode           InvestmentFixedIncomeRateMode
  annual_rate    Decimal?                      @db.Decimal(9, 4)
  cdi_percent    Decimal?                      @db.Decimal(9, 4)
  spread         Decimal?                      @db.Decimal(9, 4)
  index_rate     Decimal?                      @db.Decimal(9, 4)
  effective_rate Decimal                       @db.Decimal(12, 6)
  created_at     DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                      @updatedAt @db.Timestamptz(6)

  asset InvestmentAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, start_date])
  @@map("investment_fixed_income_rates")
}

model InvestmentFixedIncomeAdjustment {
  id           String   @id @default(uuid())
  asset_id     String
  date         DateTime @db.Date
  gross_amount Int
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  asset InvestmentAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, date])
  @@map("investment_fixed_income_adjustments")
}

// Spec 107: an income of an asset; its status is the `paid` flag of the linked finance row.
model InvestmentIncome {
  id              String               @id @default(uuid())
  asset_id        String
  type            InvestmentIncomeType
  ex_date         DateTime?            @db.Date
  payment_date    DateTime             @db.Date
  quantity        Decimal?             @db.Decimal(20, 8)
  amount_per_unit Decimal?             @db.Decimal(20, 8)
  net_amount      Int
  currency        String               @db.VarChar(3)
  transaction_id  String?              @unique
  suggestion_id   String?              @unique
  notes           String?
  created_by      String
  created_at      DateTime             @default(now()) @db.Timestamptz(6)
  updated_at      DateTime             @updatedAt @db.Timestamptz(6)

  asset       InvestmentAsset             @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  transaction FinancialTransaction?       @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  suggestion  InvestmentIncomeSuggestion? @relation(fields: [suggestion_id], references: [id], onDelete: SetNull)

  @@index([asset_id, payment_date(sort: Desc), id(sort: Desc)])
  @@index([asset_id, type, ex_date])
  @@map("investment_incomes")
}

// Announced incomes: market data, no owner (like the quotes).
model InvestmentIncomeEvent {
  id              String               @id @default(uuid())
  market          QuoteMarket
  ticker          String               @db.VarChar(20)
  event_key       String               @unique
  source          String
  type            InvestmentIncomeType
  ex_date         DateTime             @db.Date
  payment_date    DateTime?            @db.Date
  amount_per_unit Decimal              @db.Decimal(20, 8)
  currency        String               @db.VarChar(3)
  fetched_at      DateTime             @db.Timestamptz(6)

  suggestions InvestmentIncomeSuggestion[]

  @@index([market, ticker, ex_date])
  @@map("investment_income_events")
}

model InvestmentIncomeSuggestion {
  id         String                     @id @default(uuid())
  asset_id   String
  event_id   String
  quantity   Decimal                    @db.Decimal(20, 8)
  status     InvestmentSuggestionStatus @default(PENDING)
  decided_by String?
  decided_at DateTime?                  @db.Timestamptz(6)
  created_at DateTime                   @default(now()) @db.Timestamptz(6)

  asset  InvestmentAsset       @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  event  InvestmentIncomeEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  income InvestmentIncome?

  @@unique([asset_id, event_id])
  @@index([asset_id, status])
  @@map("investment_income_suggestions")
}
