NODE_ENV=development
APP_ENVIRONMENT=development
PORT=3000
CORS_ORIGINS=http://localhost:8081

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
# Optional pg pool tuning (defaults: max 20, idle 30000 ms, wait for a connection 0 = no limit, statement timeout 0 = off).
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_POOL_CONNECTION_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=
FINANCE_MATERIALIZATION_GATE_TTL_MS=

JWT_SECRET=
JWT_EXPIRES_IN=
SESSION_IDLE_TTL_SECONDS=

SWAGGER_ENABLED=true

# Versions (spec 056). owner/name of each repo on GitHub; empty disables the update check.
VERSION_REPO_API=
VERSION_REPO_APP=
# Optional read-only token, only raises the GitHub rate limit.
GITHUB_TOKEN=
VERSION_CHECK_TTL_SECONDS=600

# Investment quotes (spec 104): a missing token disables that source (manual values)
BRAPI_TOKEN=your-brapi-token
FINNHUB_TOKEN=your-finnhub-token
INVESTMENT_QUOTES_JOB_ENABLED=true
INVESTMENT_QUOTES_BRAPI_BATCH_SIZE=20
INVESTMENT_QUOTES_MIN_INTERVAL_MS=0
INVESTMENT_QUOTE_REFRESH_COOLDOWN_MS=60000

# Perf seed (spec 064): dedicated account, local API only
# Optional: defaults to perf-base-user@example.com (the pinned base user, spec 093)
PERF_USER_EMAIL=
PERF_USER_PASSWORD=your-perf-user-password
PERF_SEED_ALLOW=
PERF_DB_HOST_ALLOW=
PERF_API_URL=
# Perf guardrail (spec 065): set to 1 only for `yarn perf` runs
PERF_COUNT_QUERIES=

# Monitoring (spec 106): leave SENTRY_ENABLED=false locally. SENTRY_AUTH_TOKEN is a build-time secret (source map upload only)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=your-organization
SENTRY_PROJECT=your-project-name
SENTRY_URL=https://sentry.io/
SENTRY_AUTH_TOKEN=your-sentry-auth-token
